# --- LLM (Claude via Anthropic API) ---
ANTHROPIC_API_KEY=
# Only for an org-level (unscoped) key on a multi-workspace account. Leave blank
# if your key was created inside a workspace (the normal case).
ANTHROPIC_WORKSPACE_ID=
# Leave blank -> hits https://api.anthropic.com. Override only for a proxy.
ANTHROPIC_BASE_URL=
# Judgment steps (Propose, Synthesize) — where errors compound, so don't cheap out.
ANTHROPIC_MODEL_JUDGMENT=claude-opus-5
# Mechanical steps (recon query-gen, company one-liners) — high volume, downgrade candidate.
ANTHROPIC_MODEL_MECHANICAL=claude-sonnet-5

# --- Web search / verification (Exa) ---
EXA_API_KEY=

# --- Observability (LangSmith) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=market-map-agent
# LANGSMITH_TRACING is set automatically by the app when a key is present.

# --- Database (Supabase Postgres): run-log table + LangGraph checkpointer ---
# Direct connection string from Supabase -> Project Settings -> Database.
DATABASE_URL=

# --- Behaviour ---
# Force deterministic stub mode even when keys are present (used by the e2e demo).
# Set to false for real runs; it also auto-falls-back to stubs if a key is missing.
USE_STUBS=true
RESCOPE_CAP=2

# --- Public-deploy cost guardrail (leave both blank locally) ---
# New-run ("map") caps per calendar day, so a public link with real keys can't
# run up a bill. Per-IP stops one visitor from eating the whole budget; global
# is a backstop against IP rotation. See backend/app/rate_limit.py.
DAILY_RUN_LIMIT_PER_IP=
DAILY_RUN_LIMIT_GLOBAL=
